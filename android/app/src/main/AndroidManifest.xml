<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LilosGarden">

        <!-- 1. Full-Screen Offline WebView Sanctuary Activity -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.LilosGarden.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Stardew Valley Home Screen Widget Provider -->
        <receiver
            android:name=".LiloWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.valois.lilosgarden.ACTION_WIDGET_PET" />
                <action android:name="com.valois.lilosgarden.ACTION_WIDGET_FEED" />
                <action android:name="com.valois.lilosgarden.ACTION_WIDGET_WEATHER" />
                <action android:name="com.valois.lilosgarden.ACTION_WIDGET_ADD_CAT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lilo_widget_info" />
        </receiver>

        <!-- 3. Interactive Live Wallpaper Service -->
        <service
            android:name=".LiloWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lilo_wallpaper_info" />
        </service>

        <!-- 4. Split-Screen Cat Companion & Live Clock/Weather Widget Provider -->
        <receiver
            android:name=".LiloCompanionWidgetProvider"
            android:exported="true"
            android:label="@string/companion_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.valois.lilosgarden.ACTION_COMP_POSE" />
                <action android:name="com.valois.lilosgarden.ACTION_COMP_SWITCH_CAT" />
                <action android:name="com.valois.lilosgarden.ACTION_COMP_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lilo_companion_widget_info" />
        </receiver>

        <!-- 5. Wooden Window Peek & Dynamic Sky Clock Widget Provider -->
        <receiver
            android:name=".LiloWindowWidgetProvider"
            android:exported="true"
            android:label="@string/window_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.valois.lilosgarden.ACTION_WIN_PET" />
                <action android:name="com.valois.lilosgarden.ACTION_WIN_SWITCH_CAT" />
                <action android:name="com.valois.lilosgarden.ACTION_WIN_WEATHER" />
                <action android:name="com.valois.lilosgarden.ACTION_WIN_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lilo_window_widget_info" />
        </receiver>

        <!-- 6. Purr-cent Battery & Cat Mood Widget Provider (Option A) -->
        <receiver
            android:name=".LiloBatteryWidgetProvider"
            android:exported="true"
            android:label="@string/battery_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="com.valois.lilosgarden.ACTION_BAT_PET" />
                <action android:name="com.valois.lilosgarden.ACTION_BAT_SWITCH_CAT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lilo_battery_widget_info" />
        </receiver>

        <!-- 7. Campfire Focus / Pomodoro Buddy Widget Provider (Option C) -->
        <receiver
            android:name=".LiloPomodoroWidgetProvider"
            android:exported="true"
            android:label="@string/pomodoro_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.valois.lilosgarden.ACTION_POMO_TOGGLE" />
                <action android:name="com.valois.lilosgarden.ACTION_POMO_RESET" />
                <action android:name="com.valois.lilosgarden.ACTION_POMO_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lilo_pomodoro_widget_info" />
        </receiver>

    </application>

</manifest>
