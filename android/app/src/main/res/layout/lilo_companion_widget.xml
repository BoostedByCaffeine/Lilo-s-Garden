<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comp_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="154dp"
        android:layout_gravity="center">

        <!-- LAYER 1: 12-Frame Pixel Animation Loop @ 3.3 FPS (300ms) -->
        <ViewFlipper
            android:id="@+id/comp_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:autoStart="true"
            android:flipInterval="300" />

        <!-- LAYER 2: High-Res Solid Typography Overlay (Updated via partiallyUpdateAppWidget on minute ticks) -->
        <ImageView
            android:id="@+id/comp_hud_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/comp_left_frame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:id="@+id/comp_right_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingTop="32dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:weightSum="100">

                <FrameLayout
                    android:id="@+id/comp_clock_hotspot"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="66"
                    android:background="@android:color/transparent">

                    <TextClock
                        android:id="@+id/comp_clock"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:alpha="0"
                        android:format12Hour="hh:mm a"
                        android:format24Hour="HH:mm" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="34"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="100">

                    <FrameLayout
                        android:id="@+id/comp_weather_hotspot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="56"
                        android:background="@android:color/transparent" />

                    <FrameLayout
                        android:id="@+id/comp_btn_action"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="22"
                        android:background="@android:color/transparent" />

                    <FrameLayout
                        android:id="@+id/comp_btn_switch_cat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="22"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
