<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:layout_gravity="center">

        <ViewFlipper
            android:id="@+id/music_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:autoStart="true"
            android:flipInterval="300" />

        <ImageView
            android:id="@+id/music_hud_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="10dp"
            android:weightSum="100">

            <!-- Left 34%: Vinyl Turntable & Cats -->
            <FrameLayout
                android:id="@+id/music_open_app"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="34"
                android:background="@android:color/transparent" />

            <!-- Right 66%: Top 64% Track Info Card, Bottom 36% Media Control Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="66"
                android:orientation="vertical"
                android:weightSum="100">

                <FrameLayout
                    android:id="@+id/music_info_hotspot"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="64"
                    android:background="@android:color/transparent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="36"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <FrameLayout
                        android:id="@+id/music_btn_prev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />

                    <FrameLayout
                        android:id="@+id/music_btn_play_pause"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />

                    <FrameLayout
                        android:id="@+id/music_btn_next"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
