<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notes_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="154dp"
        android:layout_gravity="center">

        <!-- LAYER 1: Pixel Animation Loop (12 frames @ 300ms) -->
        <ViewFlipper
            android:id="@+id/notes_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:autoStart="true"
            android:flipInterval="300" />

        <!-- LAYER 2: High-Res Notice Board & Typography Overlay -->
        <ImageView
            android:id="@+id/notes_hud_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <!-- Interactive Hotspots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="100">

            <!-- Top Header & Task List: Tap to check off current top incomplete task -->
            <FrameLayout
                android:id="@+id/notes_tasks_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="72"
                android:background="@android:color/transparent" />

            <!-- Bottom Note & Edit Bar: Tap to launch App into #modalTasks -->
            <FrameLayout
                android:id="@+id/notes_edit_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="28"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
