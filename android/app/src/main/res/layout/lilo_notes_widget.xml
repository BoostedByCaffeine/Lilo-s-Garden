<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notes_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_gravity="center">

        <!-- LAYER 1: Pixel Animation Loop (12 frames @ 300ms) -->
        <ViewFlipper
            android:id="@+id/notes_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:autoStart="true"
            android:flipInterval="300" />

        <!-- LAYER 2: High-Res Notice Board & Typography Overlay -->
        <ImageView
            android:id="@+id/notes_hud_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <!-- Interactive Hotspots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="100">

            <!-- Top Header Area: Tap to open tasks in App -->
            <FrameLayout
                android:id="@+id/notes_open_app"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="18"
                android:background="@android:color/transparent" />

            <!-- Task Row 0 Hotspot -->
            <FrameLayout
                android:id="@+id/notes_row_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="16"
                android:background="@android:color/transparent" />

            <!-- Task Row 1 Hotspot -->
            <FrameLayout
                android:id="@+id/notes_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="16"
                android:background="@android:color/transparent" />

            <!-- Task Row 2 Hotspot -->
            <FrameLayout
                android:id="@+id/notes_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="16"
                android:background="@android:color/transparent" />

            <!-- Bottom Sticky Note / Edit Area: Tap to launch App into #modalTasks -->
            <FrameLayout
                android:id="@+id/notes_edit_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="34"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
