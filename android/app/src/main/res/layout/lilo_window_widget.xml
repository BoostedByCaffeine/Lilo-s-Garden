<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@android:color/transparent" android:id="@+id/win_widget_root" android:layout_height="match_parent" android:layout_width="match_parent" xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout android:layout_gravity="center" android:layout_height="154dp" android:layout_width="match_parent">

        <!-- Hidden TextClock triggers launcher time-tick updates while Canvas renders 100% pixel font -->
        <TextClock android:alpha="0" android:id="@+id/win_clock" android:layout_height="1dp" android:layout_width="1dp"/>

        <ViewFlipper android:autoStart="true" android:flipInterval="280" android:id="@+id/win_flipper" android:layout_centerInParent="true" android:layout_height="match_parent" android:layout_width="match_parent">

            <ImageView android:id="@+id/win_frame_0" android:layout_height="match_parent" android:layout_width="match_parent" android:scaleType="fitCenter"/>

            <ImageView android:id="@+id/win_frame_1" android:layout_height="match_parent" android:layout_width="match_parent" android:scaleType="fitCenter"/>

            <ImageView android:id="@+id/win_frame_2" android:layout_height="match_parent" android:layout_width="match_parent" android:scaleType="fitCenter"/>

            <ImageView android:id="@+id/win_frame_3" android:layout_height="match_parent" android:layout_width="match_parent" android:scaleType="fitCenter"/>
        </ViewFlipper>

        <LinearLayout android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" android:paddingBottom="10dp" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="14dp" android:weightSum="100">

            <LinearLayout android:gravity="center_vertical" android:layout_height="0dp" android:layout_weight="38" android:layout_width="match_parent" android:orientation="horizontal" android:weightSum="100">

                <FrameLayout android:background="@android:color/transparent" android:id="@+id/win_clock_box" android:layout_height="match_parent" android:layout_weight="65" android:layout_width="0dp"/>

                <FrameLayout android:background="@android:color/transparent" android:id="@+id/win_btn_weather" android:layout_height="match_parent" android:layout_weight="35" android:layout_width="0dp"/>
            </LinearLayout>

            <FrameLayout android:background="@android:color/transparent" android:id="@+id/win_open_app_area" android:layout_height="0dp" android:layout_weight="22" android:layout_width="match_parent"/>

            <LinearLayout android:layout_height="0dp" android:layout_weight="40" android:layout_width="match_parent" android:orientation="horizontal" android:weightSum="100">

                <FrameLayout android:background="@android:color/transparent" android:id="@+id/win_btn_pet_cats" android:layout_height="match_parent" android:layout_weight="80" android:layout_width="0dp"/>

                <FrameLayout android:background="@android:color/transparent" android:id="@+id/win_btn_switch_cat" android:layout_height="match_parent" android:layout_weight="20" android:layout_width="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
