<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/win_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="154dp"
        android:layout_gravity="center">

        <TextClock
            android:id="@+id/win_clock"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0" />

        <!-- LAYER 1: 64-Frame Pixel Animation Loop @ 4 FPS (250ms per frame = 16s seamless cycle) -->
        <ViewFlipper
            android:id="@+id/win_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:autoStart="true"
            android:flipInterval="250" />

        <!-- LAYER 2: High-Res Solid Typography Overlay (Updated independently on minute ticks) -->
        <ImageView
            android:id="@+id/win_hud_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <!-- Interactive Touch Hotspots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="14dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:weightSum="100">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="38"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="100">

                <FrameLayout
                    android:id="@+id/win_clock_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="65"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/win_btn_weather"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="35"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/win_open_app_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="22"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="40"
                android:orientation="horizontal"
                android:weightSum="100">

                <FrameLayout
                    android:id="@+id/win_btn_pet_cats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="80"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/win_btn_switch_cat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="20"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
